ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_KEY_HERE
PORT=3000
NODE_ENV=development

# Production only (a VPS with a real public IP) — leave unset for local dev.
# PUBLIC_IP is the box's public IPv4 address; ICE_PORT_MIN/MAX must match the UDP port
# range opened in the server's firewall for WebRTC audio.
# PUBLIC_IP=203.0.113.10
# ICE_PORT_MIN=40000
# ICE_PORT_MAX=40100
